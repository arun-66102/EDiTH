__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
.venv/
env/

# Environment variables
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Model weights (too large for git)
*.pth
*.pt
*.onnx
*.h5
*.ppt
*.pptx

# Training checkpoints
training/checkpoints/

# ChromaDB storage
data/chroma_db/

# Logs
*.log
